@model SellerProductFormModel
@{
    var isNew = Model.ProductId == Guid.Empty;
    ViewData["Title"] = isNew ? "Add product" : "Edit product";
    var formAction = isNew ? "Create" : "Edit";
}
<div class="card form-card">
    <h1>@ViewData["Title"]</h1>
    @if (TempData["ProductError"] is string formError)
    {
        <div class="alert alert--error" role="alert">@formError</div>
    }
    <partial name="_ValidationSummary" />
    <form asp-area="Seller" asp-controller="Products" asp-action="@formAction" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="RowVersion" />

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" type="text" maxlength="160" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories">
                <option value="0">Choose a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" rows="4" maxlength="2000"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Price"></label>
            <input asp-for="Price" type="number" step="0.01" min="0" inputmode="decimal" />
            <span asp-validation-for="Price" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="QuantityAvailable"></label>
            <input asp-for="QuantityAvailable" type="number" step="1" min="0" inputmode="numeric" />
            <span asp-validation-for="QuantityAvailable" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Condition"></label>
            <select asp-for="Condition" asp-items="Model.Conditions"></select>
            <span asp-validation-for="Condition" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="LowStockThreshold"></label>
            <input asp-for="LowStockThreshold" type="number" step="1" min="0" inputmode="numeric" />
            <span class="hint">Optional. Leave blank to use the default of 3.</span>
            <span asp-validation-for="LowStockThreshold" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Image">Product image</label>
            @if (Model.ExistingImageUrl is not null)
            {
                <img class="thumb thumb--large" src="@Model.ExistingImageUrl" alt="@Model.Name" />
            }
            <input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <span class="hint">One image. JPG, PNG or WebP, up to 5 MB. Choosing a new file replaces the current one.</span>
            <span asp-validation-for="Image" class="field-error"></span>
            @if (Model.ExistingImageUrl is not null)
            {
                <div class="field--check">
                    <input asp-for="RemoveImage" />
                    <label asp-for="RemoveImage"></label>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--block">Save</button>
            <a class="btn btn--secondary btn--block" asp-area="Seller" asp-controller="Products" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

