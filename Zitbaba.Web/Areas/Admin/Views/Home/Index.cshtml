@{ ViewData["Title"] = "Admin"; }
<h1>Admin dashboard</h1>

<div class="card list-card">
    <h2>Seller applications</h2>
    <p>Review, approve, reject or suspend sellers.</p>
    <a class="btn" asp-area="Admin" asp-controller="SellerApprovals" asp-action="Index">Review applications</a>
</div>

<div class="card list-card">
    <h2>Categories</h2>
    <p>Add, rename, reorder and deactivate product categories.</p>
    <a class="btn" asp-area="Admin" asp-controller="Categories" asp-action="Index">Manage categories</a>
</div>

<p class="muted">User moderation arrives later.</p>

