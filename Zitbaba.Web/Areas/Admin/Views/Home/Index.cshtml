@model Zitbaba.Web.Services.AdminDashboardModel
@{ ViewData["Title"] = "Admin"; }
<h1>Admin dashboard</h1>

<div class="stat-grid">
    <div class="stat">
        <span class="stat-value">@Model.PendingApplications</span>
        <span>Pending seller applications</span>
    </div>
    <div class="stat">
        <span class="stat-value">@Model.TotalProducts</span>
        <span>Products (not removed)</span>
    </div>
</div>

<div class="card list-card">
    <h2>Seller applications</h2>
    <p>Review, approve, reject or suspend sellers.</p>
    <a class="btn" asp-area="Admin" asp-controller="SellerApprovals" asp-action="Index">Review applications</a>
</div>

<div class="card list-card">
    <h2>Users</h2>
    <p>Search accounts, suspend or reactivate them.</p>
    <a class="btn" asp-area="Admin" asp-controller="Users" asp-action="Index">Manage users</a>
</div>

<div class="card list-card">
    <h2>Categories</h2>
    <p>Add, rename and deactivate product categories.</p>
    <a class="btn" asp-area="Admin" asp-controller="Categories" asp-action="Index">Manage categories</a>
</div>

<div class="card list-card">
    <h2>Audit log</h2>
    <p>See who did what and when.</p>
    <a class="btn" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">View audit log</a>
</div>
