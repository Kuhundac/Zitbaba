@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="card form-card">
    <h1>Choose a new password</h1>
    <partial name="_ValidationSummary" />
    <form asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn--block">Reset password</button>
    </form>
</div>
