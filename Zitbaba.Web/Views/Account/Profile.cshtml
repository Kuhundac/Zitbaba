@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var kind = Model.AccountStatus == "Active" ? BadgeKind.Success : BadgeKind.Warning;
}
<div class="card form-card">
    <h1>Your profile</h1>
    <p class="muted">Only you can see this page.</p>
    <dl class="details">
        <dt>Name</dt><dd>@Model.FullName</dd>
        <dt>Email</dt><dd>@Model.Email</dd>
        <dt>Phone</dt><dd>@Model.Phone</dd>
        <dt>Roles</dt><dd>@string.Join(", ", Model.Roles)</dd>
        <dt>Status</dt><dd><partial name="_StatusBadge" model="new StatusBadgeViewModel(Model.AccountStatus, kind)" /></dd>
    </dl>
</div>
