@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="card form-card">
    <h1>Forgot your password?</h1>
    <partial name="_ValidationSummary" />
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <button type="submit" class="btn btn--block">Send reset link</button>
    </form>
</div>
