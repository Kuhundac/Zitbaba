@model Zitbaba.Web.Services.OrderDetail
@using Zitbaba.Web.Infrastructure.Extensions
@{
    ViewData["Title"] = "Order " + Model.OrderNumber;
    var justPlaced = TempData["Placed"] is string;
}

@if (justPlaced)
{
    <section class="card confirm-panel" role="status">
        <h2>Thank you, your order has been placed.</h2>
        <p>Your order number is <strong>@Model.OrderNumber</strong>. Quote it when you collect.</p>
        <p>The seller will accept your order first. You pay cash when you collect it.</p>
    </section>
}

@* cancel-step4 *@
@if (TempData["OrderMessage"] is string buyerOrderMessage)
{
    <div class="alert alert--success" role="status">@buyerOrderMessage</div>
}
@if (TempData["OrderError"] is string buyerOrderError)
{
    <div class="alert alert--error" role="alert">@buyerOrderError</div>
}
<h1>Order <span class="order-number">@Model.OrderNumber</span></h1>
<p class="muted">
    Placed @OrderLabels.When(Model.CreatedAt) from
    <a asp-controller="Store" asp-action="Index" asp-route-id="@Model.SellerProfileId">@Model.StoreName</a>
</p>

<p><strong>Status:</strong> @OrderLabels.Status(Model.Status)</p>
<p><strong>Payment:</strong> @OrderLabels.Payment(Model.PaymentStatus)</p>
<p><strong>Collection:</strong> pickup from the seller</p>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th scope="col">Item</th>
                <th scope="col">Price</th>
                <th scope="col">Quantity</th>
                <th scope="col">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td>@MoneyFormatter.Zmw(line.UnitPrice)</td>
                    <td>@line.Quantity</td>
                    <td>@MoneyFormatter.Zmw(line.LineTotal)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="cart-total">Total: @MoneyFormatter.Zmw(Model.Total)</p>

@{
    var orderIdValue = Context.Request.RouteValues["id"]?.ToString();
    var canCancel = Zitbaba.Web.Domain.Rules.OrderRules.CanTransition(
        Model.Status,
        Zitbaba.Web.Domain.Enums.OrderStatus.CancelledByBuyer,
        Zitbaba.Web.Domain.Rules.OrderActor.Buyer);
}
@if (canCancel)
{
    <section class="card" aria-labelledby="cancel-heading">
        <h2 id="cancel-heading">Changed your mind?</h2>
        <p class="hint">You can cancel until the seller marks the order ready for pickup. The items go back into stock.</p>
        <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@orderIdValue" method="post" class="action-form" data-submit-once>
            <div class="field">
                <label for="cancel-reason">Reason (optional)</label>
                <textarea id="cancel-reason" name="reason" rows="2" maxlength="500" class="reason-input"></textarea>
            </div>
            <button type="submit" class="btn btn--secondary">Cancel this order</button>
        </form>
    </section>
}
else if (Model.Status == Zitbaba.Web.Domain.Enums.OrderStatus.ReadyForPickup)
{
    <p class="hint">This order is ready for pickup, so it can no longer be cancelled here. Please speak to the seller.</p>
}
<h2>History</h2>
<ol>
    @foreach (var entry in Model.History)
    {
        <li>
            @OrderLabels.Status(entry.To) &middot; @OrderLabels.When(entry.At)
            @if (!string.IsNullOrWhiteSpace(entry.Reason))
            {
                <span class="muted"> &middot; @entry.Reason</span>
            }
        </li>
    }
</ol>

<p>
    <a asp-controller="Orders" asp-action="Index">All my orders</a> &middot;
    <a asp-controller="Home" asp-action="Search">Continue shopping</a>
</p>

