@model CatalogueProductDetail
@using Zitbaba.Web.Domain.Enums
@using Zitbaba.Web.Infrastructure.Extensions
@using Zitbaba.Web.Services
@{
    ViewData["Title"] = Model.Name;
    var conditionText = Model.Condition == ProductCondition.LikeNew ? "Like new" : Model.Condition.ToString();
    var stockBadge = Model.Stock switch
    {
        CatalogueStock.OutOfStock => new StatusBadgeViewModel("Out of stock", BadgeKind.Warning),
        CatalogueStock.LowStock => new StatusBadgeViewModel("Few left", BadgeKind.Info),
        _ => new StatusBadgeViewModel("In stock", BadgeKind.Success)
    };
    var mainImage = Model.ImageUrls.Count > 0 ? Model.ImageUrls[0] : Url.Content("~/img/placeholder.svg");
    var seller = Model.Seller;
}

<p><a asp-controller="Home" asp-action="Search">Back to search</a></p>

<div class="product-detail">
    <div>
        <img class="detail-image" src="@mainImage" alt="@Model.Name" />
    </div>

    <div>
        <h1>@Model.Name</h1>
        <p class="price">@MoneyFormatter.Zmw(Model.Price)</p>
        <p><partial name="_StatusBadge" model="stockBadge" /></p>

        @if (Model.Stock == CatalogueStock.OutOfStock)
        {
            <p>This product is currently out of stock.</p>
        }
        else if (Model.Stock == CatalogueStock.LowStock)
        {
            <p>Only @Model.QuantityAvailable left.</p>
        }

        <p class="muted">
            @conditionText &middot;
            @if (Model.ParentCategoryName is not null)
            {
                <span>@Model.ParentCategoryName &gt; </span>
            }
            <a asp-controller="Home" asp-action="Search" asp-route-categoryId="@Model.CategoryId">@Model.CategoryName</a>
        </p>

        @if (TempData["Message"] is string wishlistMessage)
        {
            <p role="status">@wishlistMessage</p>
        }
        @if (TempData["Error"] is string wishlistError)
        {
            <p role="alert" class="field-error">@wishlistError</p>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            var isSaved = ViewData["IsSaved"] as bool? == true;
            var wishlistAction = isSaved ? "Remove" : "Add";
            var wishlistLabel = isSaved ? "Remove from wishlist" : "Save to wishlist";
            <form asp-controller="Wishlist" asp-action="@wishlistAction" method="post" class="action-form">
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="btn btn--secondary">@wishlistLabel</button>
            </form>
        }
        else
        {
            <p><a asp-controller="Account" asp-action="Login">Log in to save this product</a></p>
        }

        @if (Model.Stock != CatalogueStock.OutOfStock)
        {
            if (User.Identity?.IsAuthenticated == true)
            {
                var maxQty = Math.Min(Model.QuantityAvailable, 99);
                <form asp-controller="Cart" asp-action="Add" method="post" class="action-form cart-form">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <label for="cart-qty">Quantity</label>
                    <input id="cart-qty" type="number" name="quantity" value="1" min="1" max="@maxQty" class="qty-input" />
                    <button type="submit" class="btn">Add to cart</button>
                </form>
            }
            else
            {
                <p><a asp-controller="Account" asp-action="Login">Log in to add this product to your cart</a></p>
            }
        }
        @if (TempData["CartConflictProductId"] is string cartConflictId && cartConflictId == Model.ProductId.ToString())
        {
            var cartConflictQty = TempData["CartConflictQuantity"] as string ?? "1";
            <form asp-controller="Cart" asp-action="ReplaceAndAdd" method="post" class="action-form">
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="quantity" value="@cartConflictQty" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                <button type="submit" class="btn btn--secondary">Clear cart and add this item</button>
            </form>
        }

        <h2>Description</h2>
        @if (string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="muted">The seller has not added a description.</p>
        }
        else
        {
            <p class="pre-line">@Model.Description</p>
        }

        <section class="card seller-card" aria-labelledby="seller-heading">
            <h2 id="seller-heading">Seller</h2>
            <p><strong><a asp-controller="Store" asp-action="Index" asp-route-id="@seller.SellerProfileId">@seller.StoreName</a></strong></p>
            @if (seller.RatingAverage is decimal average)
            {
                <p>Rated @average.ToString("0.0") out of 5 (@seller.RatingCount @(seller.RatingCount == 1 ? "rating" : "ratings"))</p>
            }
            else
            {
                <p class="muted">No ratings yet.</p>
            }
            <p class="muted">On Zitbaba since @seller.MemberSince.ToString("MMM yyyy")</p>
        </section>
    </div>
</div>



