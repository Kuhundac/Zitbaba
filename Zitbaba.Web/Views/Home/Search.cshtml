@model SearchPageModel
@using Zitbaba.Web.Domain.Enums
@using Zitbaba.Web.Services
@{
    ViewData["Title"] = "Search";
    var query = Model.Query;
    var result = Model.Result;
    var inStockRoute = query.InStockOnly ? "true" : null;
    var hasFilters = !string.IsNullOrWhiteSpace(query.Keyword)
        || query.CategoryId is not null
        || query.MinPrice is not null
        || query.MaxPrice is not null
        || query.Condition is not null
        || query.InStockOnly;

    string? PageUrl(int p) => Url.Action("Search", "Home", new
    {
        q = query.Keyword,
        categoryId = query.CategoryId,
        minPrice = query.MinPrice,
        maxPrice = query.MaxPrice,
        condition = query.Condition,
        inStock = inStockRoute,
        sort = query.Sort,
        page = p
    });
}

<h1>Search</h1>

<form class="filter-form" role="search" asp-controller="Home" asp-action="Search" method="get">
    <div class="field">
        <label for="q">Search products</label>
        <input id="q" name="q" type="search" maxlength="100" value="@query.Keyword" autocomplete="off" />
    </div>

    <div class="field">
        <label for="categoryId">Category</label>
        <select id="categoryId" name="categoryId">
            <option value="">All categories</option>
            @foreach (var parent in Model.Categories)
            {
                <option value="@parent.CategoryId" selected="@(query.CategoryId == parent.CategoryId)">@parent.Name</option>
                @foreach (var child in parent.Children)
                {
                    <option value="@child.CategoryId" selected="@(query.CategoryId == child.CategoryId)">@parent.Name &gt; @child.Name</option>
                }
            }
        </select>
    </div>

    <div class="field">
        <label for="minPrice">Lowest price (ZMW)</label>
        <input id="minPrice" name="minPrice" type="number" inputmode="decimal" min="0" step="0.01" value="@query.MinPrice" />
    </div>

    <div class="field">
        <label for="maxPrice">Highest price (ZMW)</label>
        <input id="maxPrice" name="maxPrice" type="number" inputmode="decimal" min="0" step="0.01" value="@query.MaxPrice" />
    </div>

    <div class="field">
        <label for="condition">Condition</label>
        <select id="condition" name="condition">
            <option value="">Any condition</option>
            <option value="New" selected="@(query.Condition == ProductCondition.New)">New</option>
            <option value="LikeNew" selected="@(query.Condition == ProductCondition.LikeNew)">Like new</option>
            <option value="Used" selected="@(query.Condition == ProductCondition.Used)">Used</option>
        </select>
    </div>

    <div class="field">
        <label for="sort">Sort by</label>
        <select id="sort" name="sort">
            <option value="Newest" selected="@(query.Sort == CatalogueSort.Newest)">Newest first</option>
            <option value="PriceLowToHigh" selected="@(query.Sort == CatalogueSort.PriceLowToHigh)">Price: low to high</option>
            <option value="PriceHighToLow" selected="@(query.Sort == CatalogueSort.PriceHighToLow)">Price: high to low</option>
        </select>
    </div>

    <label class="check">
        <input type="checkbox" name="inStock" value="true" checked="@query.InStockOnly" />
        <span>In stock only</span>
    </label>

    <div class="filter-actions">
        <button type="submit" class="btn">Apply</button>
        @if (hasFilters)
        {
            <a asp-controller="Home" asp-action="Search">Clear filters</a>
        }
    </div>
</form>

<p class="result-count" role="status">
    @(result.TotalCount == 1 ? "1 product found" : result.TotalCount + " products found")
</p>

@if (result.Items.Count == 0)
{
    <p>No products match your search. Try fewer filters or different words.</p>
}
else
{
    <ul class="product-grid">
        @foreach (var item in result.Items)
        {
            <li><partial name="_ProductCard" model="item" /></li>
        }
    </ul>
}

@if (result.TotalPages > 1)
{
    <nav class="pager" aria-label="Pages">
        @if (result.HasPrevious)
        {
            <a href="@PageUrl(result.Page - 1)">Previous</a>
        }
        <span>Page @result.Page of @result.TotalPages</span>
        @if (result.HasNext)
        {
            <a href="@PageUrl(result.Page + 1)">Next</a>
        }
    </nav>
}
