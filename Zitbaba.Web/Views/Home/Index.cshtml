@model HomeIndexModel
@using Zitbaba.Web.Services
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
    <h1>Buy and sell on campus</h1>
    <p>Find what you need from Copperbelt University students and approved sellers.</p>
    <form class="search-form" role="search" asp-controller="Home" asp-action="Search" method="get">
        <label for="q" class="visually-hidden">Search products</label>
        <input id="q" name="q" type="search" placeholder="Search products, e.g. calculator" autocomplete="off" />
        <button type="submit" class="btn">Search</button>
    </form>
</section>

<section aria-labelledby="cats-heading">
    <h2 id="cats-heading">Browse categories</h2>
    @if (Model.Categories.Count == 0)
    {
        <p class="muted">No categories yet.</p>
    }
    else
    {
        <ul class="chips">
            @foreach (var c in Model.Categories)
            {
                <li><a class="chip" asp-controller="Home" asp-action="Search" asp-route-categoryId="@c.CategoryId">@c.Name</a></li>
            }
        </ul>
    }
    <p><a asp-controller="Home" asp-action="Categories">See all categories</a></p>
</section>

<section aria-labelledby="recent-heading">
    <h2 id="recent-heading">Recently added</h2>
    @if (Model.Recent.Count == 0)
    {
        <p class="muted">No products yet. Check back soon.</p>
    }
    else
    {
        <ul class="product-grid">
            @foreach (var item in Model.Recent)
            {
                <li><partial name="_ProductCard" model="item" /></li>
            }
        </ul>
    }
</section>
